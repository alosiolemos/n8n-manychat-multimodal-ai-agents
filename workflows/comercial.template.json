        "jsCode": "// Pegamos o e-mail da entrada\nconst email = ($('Consolidado').first().json.body?.email || \"\").trim().toLowerCase();\n\n// Domínios pessoais\nconst personalDomains = new Set([\n  // Google\n  \"gmail.com\",\n  \"googlemail.com\",\n\n  // Microsoft\n  \"hotmail.com\",\n  \"hotmail.com.br\",\n  \"hotmail.co.uk\",\n  \"hotmail.fr\",\n  \"outlook.com\",\n  \"outlook.com.br\",\n  \"live.com\",\n  \"live.com.br\",\n  \"msn.com\",\n\n  // Yahoo\n  \"yahoo.com\",\n  \"yahoo.com.br\",\n  \"ymail.com\",\n  \"rocketmail.com\",\n\n  // Apple\n  \"icloud.com\",\n  \"me.com\",\n  \"mac.com\",\n\n  // AOL\n  \"aol.com\",\n\n  // Proton\n  \"protonmail.com\",\n  \"proton.me\",\n\n  // Zoho\n  \"zoho.com\",\n  \"zohomail.com\",\n\n  // GMX\n  \"gmx.com\",\n  \"gmx.net\",\n\n  // Mail.com\n  \"mail.com\",\n\n  // Fastmail\n  \"fastmail.com\",\n  \"fastmail.fm\",\n\n  // Tuta\n  \"tuta.com\",\n  \"tutanota.com\",\n  \"tutanota.de\",\n\n  // Mailfence\n  \"mailfence.com\",\n\n  // Yandex\n  \"yandex.com\",\n  \"yandex.ru\",\n\n  // Mail.ru\n  \"mail.ru\",\n  \"bk.ru\",\n  \"inbox.ru\",\n  \"list.ru\",\n\n  // Naver\n  \"naver.com\",\n\n  // QQ\n  \"qq.com\",\n\n  // NetEase\n  \"163.com\",\n  \"126.com\",\n\n  // Brasil\n  \"uol.com.br\",\n  \"bol.com.br\",\n  \"terra.com.br\",\n  \"ig.com.br\",\n  \"globo.com\",\n  \"oi.com.br\",\n\n  // Outros\n  \"rediffmail.com\",\n  \"web.de\",\n  \"email.com\",\n  \"posteo.de\",\n  \"hey.com\"\n]);\n\n// Domínios temporários\nconst disposableDomains = new Set([\n  \"mailinator.com\",\n  \"tempmail.com\",\n  \"10minutemail.com\",\n  \"guerrillamail.com\",\n  \"sharklasers.com\",\n  \"yopmail.com\",\n  \"temp-mail.org\",\n  \"dispostable.com\",\n  \"getnada.com\",\n  \"maildrop.cc\"\n]);\n\nfunction getDomain(email) {\n  const index = email.lastIndexOf(\"@\");\n  return index > -1 ? email.substring(index + 1) : \"\";\n}\n\nconst domain = getDomain(email);\n\nlet classificacao = \"Domínio Corporativo\";\n\nif (!domain) {\n  classificacao = \"E-mail inválido\";\n} else if (disposableDomains.has(domain)) {\n  classificacao = \"Domínio Temporário\";\n} else if (personalDomains.has(domain)) {\n  classificacao = \"Domínio Pessoal\";\n}\n\nreturn {\n  email,\n  dominio: domain,\n  classificacao\n};"
      },
